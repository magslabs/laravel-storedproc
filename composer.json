{
    "name": "magslabs/laravel-storedproc",
    "type": "library",
    "keywords": ["magslabs", "laravel", "stored-procedure", "stored-procedures", "database", "mysql", "sql-server", "pagination", "output-parameters", "transactions"],
    "description": "A fluent Laravel package for calling stored procedures with support for OUTPUT parameters, pagination, and transactions.",
    "license": "MIT",
    "authors": [
        {
            "name": "masollano",
            "email": "sollano.markangelo@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.3|^8.2|^8.1|^8.0",
        "laravel/framework": "^12.0|^11.9|^10.0|^9.0"
    },
    "require-dev": {

    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "MagsLabs\\LaravelStoredProc\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MagsLabs\\LaravelStoredProc\\Providers\\PaginationServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
