{
    "name": "magslabs/laravel-storedproc",
    "type": "library",
    "description": "A fluent Laravel package for calling stored procedures with support for OUTPUT parameters, pagination, and transactions.",
    "keywords": [
        "magslabs",
        "laravel",
        "stored-procedure",
        "database",
        "mysql",
        "sql-server",
        "pagination",
        "output-parameters",
        "transactions"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "masollano",
            "email": "sollano.markangelo@gmail.com"
        }
    ],
    "homepage": "https://github.com/magslabs/laravel-storedproc",
    "support": {
        "issues": "https://github.com/magslabs/laravel-storedproc/issues",
        "source": "https://github.com/magslabs/laravel-storedproc"
    },
    "require": {
        "php": ">=8.0 <9.0",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "MagsLabs\\LaravelStoredProc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MagsLabs\\LaravelStoredProc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MagsLabs\\LaravelStoredProc\\Providers\\StoredProcedureServiceProvider",
                "MagsLabs\\LaravelStoredProc\\Providers\\PaginationServiceProvider"
            ],
            "aliases": {
                "StoredProcedure": "MagsLabs\\LaravelStoredProc\\Facades\\StoredProcedureFacade"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
